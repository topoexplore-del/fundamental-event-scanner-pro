# ═══════════════════════════════════════════════════════════════════
# FUNDAMENTAL EVENT SCANNER PRO — Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# COPY this file to .env (no extension) and fill in your real keys.
# The .env file is gitignored — your keys NEVER leave your local PC.
#
# WARNING: NEVER share your .env file. NEVER commit it to GitHub.
# If you accidentally share or commit it, REGENERATE the keys immediately:
#   - Alpha Vantage:  https://www.alphavantage.co/support/#api-key
#   - Marketstack:    https://marketstack.com/dashboard
# ═══════════════════════════════════════════════════════════════════

# Alpha Vantage API key
# Get yours at: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests/day, 5 requests/min
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Marketstack API key
# Get yours at: https://marketstack.com/dashboard
# Free tier: 100 requests/month
MARKETSTACK_API_KEY=your_marketstack_key_here

# Optional: enable deep enrichment for top N tickers (uses AV quota)
# Default: 0 (don't use AV at all). Set to 20-25 if you want detailed data
# for the top tickers in your universe each day.
FESP_DEEP_ENRICHMENT_TOP_N=0
